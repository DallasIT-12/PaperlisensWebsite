# ============================================================
# PAPERLISENS — Environment Variables Template
# ============================================================
# Salin file ini menjadi .env.local dan isi dengan nilai asli.
# JANGAN commit .env.local ke Git!
# ============================================================

# --- SUPABASE (WAJIB) ---
# Dapatkan dari: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- ADMIN AUTH ---
# Credential login admin panel /admin/login
# Buat password yang kuat dan unik!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_dengan_password_kuat_123!
ADMIN_SECRET_KEY=paperlisens_secret_jwt_key_ganti_ini

# --- NEXT.JS ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=random_secret_string_min_32_chars_ganti_ini

# --- PAYMENT GATEWAY (Midtrans) ---
# Dapatkan dari: https://dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
# Ganti ke 'production' jika sudah live
MIDTRANS_ENV=sandbox

# --- BITESHIP (Pengiriman) ---
# Dapatkan dari: https://biteship.com/dashboard → API Keys
BITESHIP_API_KEY=biteship_test_xxxxxxxxxxxx

# --- UPLOAD / STORAGE ---
# Jika menggunakan Supabase Storage (recommended, sudah terintegrasi)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=paperlisens-products

# --- WHATSAPP (Opsional) ---
# Nomor WA untuk notifikasi order (format internasional tanpa +)
WHATSAPP_NUMBER=6281260001487

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Paperlisens
NODE_ENV=development
